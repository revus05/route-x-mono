# Telegram bot token from @BotFather
BOT_TOKEN=

# PostgreSQL connection string (pooled connection on Vercel/Neon)
# In Docker: postgresql://bot_user:bot_pass@postgres:5432/routex_bot
# Local:     postgresql://bot_user:bot_pass@localhost:5432/routex_bot
DATABASE_URL=postgresql://bot_user:bot_pass@postgres:5432/routex_bot

# Direct (non-pooled) connection used by `prisma migrate`.
# Locally it is the same as DATABASE_URL; on Neon it is the *-pooler-less URL.
DATABASE_URL_UNPOOLED=postgresql://bot_user:bot_pass@postgres:5432/routex_bot

# Comma-separated Telegram user IDs that can grant admin rights via /makeadmin
SUPER_ADMIN_IDS=123456789

# --- Vercel (webhook mode) only ---
# Random string sent by Telegram in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Random string protecting the /api/setup endpoint
SETUP_SECRET=
