# Telegram bot token from @BotFather
BOT_TOKEN=

# PostgreSQL connection string
# In Docker: postgresql://bot_user:bot_pass@postgres:5432/routex_bot
# Local:     postgresql://bot_user:bot_pass@localhost:5432/routex_bot
DATABASE_URL=postgresql://bot_user:bot_pass@postgres:5432/routex_bot

# Comma-separated Telegram user IDs that can grant admin rights via /makeadmin
SUPER_ADMIN_IDS=123456789
